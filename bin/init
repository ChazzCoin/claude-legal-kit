#!/usr/bin/env python3
"""
claude-legal-kit init — bootstrap a law firm's home folder with the
claude-legal-kit foundation.

Usage:
  claude-legal-kit/bin/init [firm-home-dir]

If [firm-home-dir] is omitted, the current working directory is used.

What gets installed is declared entirely in MANIFEST.json — this script
holds NO hardcoded file list. It reads the manifest and applies each entry
by its policy:

  kit.files[]              files the kit owns (updated later via /sync)
    directory-mirror       overlay a directory's contents into the firm home
    file-replace           copy a single file (overwrites)
    opt-in                 registered but NOT installed — added manually
  bootstrap.files[]        one-time files, never overwritten by /sync
    skip-if-exists         copy only if the target is absent
    init-only-with-sha     copy + stamp {{KIT_SHA}} {{KIT_BRANCH}} {{TODAY}}
  scaffold.directories[]   empty directories created with a .gitkeep

Because the manifest is the single source of truth, adding a file to the
kit is a one-line MANIFEST.json edit — bin/init and /sync both pick it up
with no change to this script. bin/check-manifest guards the manifest
against drifting from the tree.

Cross-platform: pure Python standard library — runs the same on macOS and
Windows. Requires python3 and (for the kit-version pin) git. The kit must
already be on disk — clone it first. No network calls.
"""

import datetime
import json
import os
import shutil
import stat
import subprocess
import sys

KIT_REPO_URL = "https://github.com/ChazzCoin/claude-legal-kit"


def main():
    # ── resolve target + kit location ───────────────────────────────────────
    target = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()
    os.makedirs(target, exist_ok=True)
    target = os.path.abspath(target)

    kit_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    manifest_path = os.path.join(kit_dir, "MANIFEST.json")

    # ── preflight ───────────────────────────────────────────────────────────
    if not os.path.isfile(manifest_path):
        sys.exit("ERROR: MANIFEST.json not found at %s" % manifest_path)
    try:
        manifest = json.load(open(manifest_path))
    except (OSError, ValueError) as exc:
        sys.exit("ERROR: MANIFEST.json is not valid JSON: %s" % exc)

    # ── resolve kit identity (for the foundation.json pin) ──────────────────
    try:
        kit_sha = subprocess.check_output(
            ["git", "-C", kit_dir, "rev-parse", "HEAD"],
            stderr=subprocess.DEVNULL, text=True).strip()
        kit_branch = subprocess.check_output(
            ["git", "-C", kit_dir, "rev-parse", "--abbrev-ref", "HEAD"],
            stderr=subprocess.DEVNULL, text=True).strip()
    except (FileNotFoundError, subprocess.CalledProcessError):
        # Kit downloaded as a tarball — /sync still works, treats files as drifted.
        kit_sha, kit_branch = "unpinned", "main"
    today = datetime.date.today().isoformat()

    print("claude-legal-kit init")
    print("  source:   %s (sha: %s, branch: %s)" % (kit_dir, kit_sha[:12], kit_branch))
    print("  target:   %s" % target)
    print("  manifest: MANIFEST.json")
    print()

    failures = 0

    def err(msg):
        nonlocal failures
        failures += 1
        print("    ERROR:   %s" % msg)

    # ── 1. install files (kit.files + bootstrap.files) ──────────────────────
    print("→ Installing files (per MANIFEST.json)")
    file_entries = (manifest.get("kit", {}).get("files", [])
                    + manifest.get("bootstrap", {}).get("files", []))

    for entry in file_entries:
        policy = entry["policy"]
        src = os.path.join(kit_dir, entry["from"])
        dst = os.path.join(target, entry["to"])

        if policy == "directory-mirror":
            if not os.path.isdir(src):
                err("%s — source directory missing" % entry["from"])
                continue
            shutil.copytree(src, dst, dirs_exist_ok=True)
            print("    mirror:  %s" % entry["to"])

        elif policy == "file-replace":
            if not os.path.isfile(src):
                err("%s — source file missing" % entry["from"])
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)
            print("    file:    %s" % entry["to"])

        elif policy == "opt-in":
            print("    opt-in:  %s  (registered, not installed — see %s)"
                  % (entry["to"], entry["from"]))

        elif policy == "skip-if-exists":
            if os.path.exists(dst):
                print("    skip:    %s  (exists)" % entry["to"])
            elif not os.path.exists(src):
                err("%s — source missing" % entry["from"])
            else:
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copy2(src, dst)
                print("    create:  %s" % entry["to"])

        elif policy == "init-only-with-sha":
            if os.path.exists(dst):
                print("    skip:    %s  (exists — /sync updates the pin)" % entry["to"])
            elif not os.path.exists(src):
                err("%s — source missing" % entry["from"])
            else:
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(src, encoding="utf-8") as fh:
                    text = fh.read()
                text = (text.replace("{{KIT_SHA}}", kit_sha)
                            .replace("{{KIT_BRANCH}}", kit_branch)
                            .replace("{{TODAY}}", today))
                with open(dst, "w", encoding="utf-8") as fh:
                    fh.write(text)
                print("    create:  %s  (pinned to %s)" % (entry["to"], kit_sha[:12]))

        else:
            failures += 1
            print("    WARNING: %s — unknown policy '%s', skipped"
                  % (entry["to"], policy))

    # ── 2. restore the executable bit on installed scripts ──────────────────
    # Harmless on Windows (no exec bit); makes ./script work on macOS/Linux.
    for dirpath, _dirnames, filenames in os.walk(target):
        for fn in filenames:
            if fn.endswith((".sh", ".py", ".js")):
                p = os.path.join(dirpath, fn)
                try:
                    mode = os.stat(p).st_mode
                    os.chmod(p, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
                except OSError:
                    pass

    # ── 3. scaffold directories ─────────────────────────────────────────────
    print()
    print("→ Scaffolding directories (per MANIFEST.json)")
    for d in manifest.get("scaffold", {}).get("directories", []):
        full = os.path.join(target, d)
        os.makedirs(full, exist_ok=True)
        if not os.listdir(full):
            open(os.path.join(full, ".gitkeep"), "w").close()
            print("    create:  %s/.gitkeep" % d)
        else:
            print("    skip:    %s  (not empty)" % d)

    # ── done ────────────────────────────────────────────────────────────────
    print()
    if failures:
        print("⚠  claude-legal-kit installed with %d problem(s) — see ERROR/WARNING lines above."
              % failures)
        print("   This usually means MANIFEST.json references a path that doesn't exist.")
        print("   Run bin/check-manifest in the kit repo to diagnose.")
        print()

    print("""✅ claude-legal-kit installed.

Next steps:
  1. Open CLAUDE.md and firm/FIRM.md and fill in the {{PLACEHOLDERS}}
     — firm name, office, members, fee structures, letterhead.
  2. Add a file under drives/ for each place the firm stores work
     (this computer, an external drive, a cloud folder).
  3. Copy members/_template/ to members/<name>/ for each firm member,
     then fill in that member's CLAUDE.md.
  4. Open Claude Code in the firm home and say hello — Claude reads
     CLAUDE.md and the kit's conduct rules at the start of each session.

When the kit gets new versions later:
  - Ask Claude to "load the latest kit updates" — it reconciles your
    copy against the kit and shows you what changed before applying
    anything.
  - Your own files (CLAUDE.md, FIRM.md, matters, members, drives) are
    never touched. Kit rules, skills, and templates are.

Source: %s""" % KIT_REPO_URL)

    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
